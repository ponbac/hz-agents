#!/bin/bash
set -euo pipefail

TOOL_PATH="/opt/npm-global/bin:/opt/mise/installs/dotnet/${dotnet_version}:/opt/mise/installs/node/${node_version}/bin:/home/azdoagent/.dotnet/tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
DOTNET_ROOT="/opt/mise/installs/dotnet/${dotnet_version}"
AGENT_HOME="/home/azdoagent"
source /etc/azdo/ld-apport-cache-env.sh

# /etc/environment does not expand variables, so write fully expanded values.
cat > /etc/environment <<ENVIRONMENT
MISE_DATA_DIR=/opt/mise
MISE_SKIP_RESHIM=1
DOTNET_ROOT=$DOTNET_ROOT
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
NUGET_XMLDOC_MODE=skip
COREPACK_HOME=$COREPACK_HOME
NUGET_PACKAGES=$NUGET_PACKAGES
pnpm_config_cache=$pnpm_config_cache
PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH
PATH="$TOOL_PATH"
ENVIRONMENT

for svc in /etc/systemd/system/vsts.agent.*.service; do
  [ -f "$svc" ] || continue
  mkdir -p "$svc.d"
  cat > "$svc.d/env.conf" <<ENVCONF
[Service]
Environment=HOME=$AGENT_HOME
Environment=MISE_DATA_DIR=/opt/mise
Environment=MISE_SKIP_RESHIM=1
Environment=DOTNET_ROOT=$DOTNET_ROOT
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
Environment=NUGET_XMLDOC_MODE=skip
Environment=COREPACK_HOME=$COREPACK_HOME
Environment=NUGET_PACKAGES=$NUGET_PACKAGES
Environment=pnpm_config_cache=$pnpm_config_cache
Environment=PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH
Environment=PATH=$TOOL_PATH
ENVCONF
done

systemctl daemon-reload
