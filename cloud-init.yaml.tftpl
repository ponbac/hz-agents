#cloud-config
package_update: true
package_upgrade: true
ssh_pwauth: false

users:
  - name: azureuser
    groups: sudo,docker
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  - curl
  - git
  - jq
  - ca-certificates
  - gnupg
  - apt-transport-https
  - zip
  - unzip
  - docker.io
  - docker-compose-v2
  - docker-buildx
  - ufw
  - fail2ban

write_files:
  - path: /etc/azdo/pat
    permissions: "0600"
    owner: root:root
    content: |
      ${azure_pat}

  - path: /opt/azdo/install_agents.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail

      ORG_URL="${azure_org_url}"
      POOL="${azure_agent_pool}"
      PAT_FILE="/etc/azdo/pat"
      BASE_DIR="/opt/azdo"

      # Use direct paths to mise-installed tools (bypasses slow shims)
      export PATH="/opt/mise/installs/dotnet/10.0.102:/opt/mise/installs/node/24.13.0/bin:$PATH"

      mkdir -p "$${BASE_DIR}"
      chmod 750 "$${BASE_DIR}"

      for i in $(seq 1 ${agents_per_vm}); do
        AGENT_DIR="$${BASE_DIR}/agent$${i}"
        AGENT_NAME="$(hostname)"
        if [ ${agents_per_vm} -gt 1 ]; then
          AGENT_NAME="$${AGENT_NAME}-$${i}"
        fi

        rm -rf "$${AGENT_DIR}"
        mkdir -p "$${AGENT_DIR}"
        cd "$${AGENT_DIR}"

        DOWNLOAD_URL="https://download.agent.dev.azure.com/agent/${azdo_agent_version}/vsts-agent-linux-x64-${azdo_agent_version}.tar.gz"
        echo "Downloading agent from: $${DOWNLOAD_URL}"
        
        MAX_RETRIES=10
        RETRY_COUNT=0
        until curl -fsSL -o agent.tar.gz "$${DOWNLOAD_URL}"; do
          RETRY_COUNT=$((RETRY_COUNT + 1))
          if [ $${RETRY_COUNT} -ge $${MAX_RETRIES} ]; then
            echo "Failed to download agent after $${MAX_RETRIES} attempts. Exiting."
            exit 1
          fi
          echo "Download failed (attempt $${RETRY_COUNT}/$${MAX_RETRIES}), retrying in 5 seconds..."
          sleep 5
        done
        tar -zxf agent.tar.gz
        rm agent.tar.gz

        export AGENT_ALLOW_RUNASROOT=1
        ./config.sh \
          --unattended \
          --url "${azure_org_url}" \
          --auth pat \
          --token "$(cat $${PAT_FILE})" \
          --pool "${azure_agent_pool}" \
          --agent "$${AGENT_NAME}" \
          --acceptTeeEula \
          --replace

        ./svc.sh install
        ./svc.sh start
      done

runcmd:
  - [bash, -c, "until ping -c 1 google.com; do sleep 2; done"]
  - [bash, -c, "ufw allow OpenSSH || true"]
  - [bash, -c, "ufw --force enable || true"]

  # Install mise (system-wide)
  - [
      bash,
      -c,
      "curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh",
    ]

  # Install Node.js and .NET using mise (pinned versions)
  - [
      bash,
      -c,
      "MISE_DATA_DIR=/opt/mise /usr/local/bin/mise install node@24.13.0 dotnet@10.0.102",
    ]

  # Use direct paths to installed tools (bypasses mise shims which have slow remote lookups)
  # NOTE: /etc/environment does not expand variables like $PATH; write a fully expanded PATH.
  - [
      bash,
      -c,
      'echo ''PATH="/opt/mise/installs/dotnet/10.0.102:/opt/mise/installs/node/24.13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"'' >> /etc/environment',
    ]

  - [bash, -c, "systemctl enable --now docker || true"]
  - [bash, -c, "systemctl enable --now fail2ban || true"]
  - [bash, -c, "usermod -aG docker azureuser || true"]
  - [
      bash,
      -c,
      'PATH="/opt/mise/installs/dotnet/10.0.102:/opt/mise/installs/node/24.13.0/bin:$PATH" /opt/azdo/install_agents.sh',
    ]

  # Configure systemd environment for all agent services (they don't read /etc/environment)
  # Uses direct paths to tools, bypassing mise shims entirely
  - [
      bash,
      -c,
      'for svc in /etc/systemd/system/vsts.agent.*.service; do [ -f "$svc" ] && mkdir -p "$svc.d" && printf "[Service]\nEnvironment=PATH=/opt/mise/installs/dotnet/10.0.102:/opt/mise/installs/node/24.13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n" > "$svc.d/env.conf"; done && systemctl daemon-reload',
    ]

  # Restart agent services to pick up new environment
  - [bash, -c, "systemctl restart 'vsts.agent.*' || true"]
