#cloud-config
package_update: true
package_upgrade: true
ssh_pwauth: false

users:
  - name: azureuser
    groups: sudo
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}
  - name: azdoagent
    shell: /bin/bash
    lock_passwd: true

packages:
  - curl
  - git
  - jq
  - ca-certificates
  - gnupg
  - apt-transport-https
  - zip
  - unzip
  - build-essential
  - python3
  - docker.io
  - docker-compose-v2
  - docker-buildx
  - ufw
  - fail2ban
  # Explicit Chromium runtime dependencies for Playwright on Ubuntu 26.04.
  # `playwright install-deps` does not currently install the full set on this image.
  - libnspr4
  - libnss3
  - libatk1.0-0t64
  - libatk-bridge2.0-0t64
  - libcups2t64
  - libdrm2
  - libxkbcommon0
  - libxcomposite1
  - libxdamage1
  - libxfixes3
  - libxrandr2
  - libgbm1
  - libasound2t64
  - libpango-1.0-0
  - libcairo2

write_files:
  - path: /etc/azdo/pat
    permissions: "0600"
    owner: root:root
    content: |
      ${azure_pat}

  - path: /etc/profile.d/azdo-tools.sh
    permissions: "0644"
    owner: root:root
    content: |
      export MISE_DATA_DIR=/opt/mise
      export MISE_SKIP_RESHIM=1
      export DOTNET_ROOT=/opt/mise/installs/dotnet/${dotnet_version}
      export DOTNET_CLI_TELEMETRY_OPTOUT=1
      export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
      export NUGET_XMLDOC_MODE=skip
      . /etc/azdo/ld-apport-cache-env.sh
      export PATH="/opt/mise/installs/dotnet/${dotnet_version}:/opt/mise/installs/node/${node_version}/bin:/home/azdoagent/.dotnet/tools:$PATH"

  - path: /etc/azdo/ld-apport-cache-env.sh
    permissions: "0644"
    owner: root:root
    content: |
      export COREPACK_HOME=/home/azdoagent/.cache/corepack
      export NUGET_PACKAGES=/home/azdoagent/.nuget/packages
      export pnpm_config_cache=/home/azdoagent/.pnpm-store
      export PLAYWRIGHT_BROWSERS_PATH=/home/azdoagent/.cache/ms-playwright
      export LD_APPORT_CACHE_DIRS="/home/azdoagent/.cache $COREPACK_HOME $PLAYWRIGHT_BROWSERS_PATH /home/azdoagent/.nuget $NUGET_PACKAGES $pnpm_config_cache"

  - path: /opt/azdo/configure_agent_environment.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${configure_agent_environment_script}

  - path: /opt/azdo/configure_swap.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${configure_swap_script}

  - path: /opt/azdo/install_powershell.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${install_powershell_script}

  - path: /opt/azdo/install_agents.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${install_agents_script}

runcmd:
  - [bash, -c, "until ping -c 1 google.com; do sleep 2; done"]
  - [bash, -c, "ufw allow OpenSSH || true"]
  - [bash, -c, "ufw --force enable || true"]

  # Add swap before installing heavy CI toolchains to absorb memory spikes.
  - [bash, -c, "/opt/azdo/configure_swap.sh"]

  # Install PowerShell and Azure CLI for Azure Pipelines scripts/tasks.
  - [bash, -c, "/opt/azdo/install_powershell.sh"]
  - [bash, -c, "curl -sL https://aka.ms/InstallAzureCLIDeb | bash"]
  - [
      bash,
      -c,
      "az config set extension.use_dynamic_install=yes_without_prompt && az extension add --name azure-devops || true",
    ]

  # Install mise (system-wide).
  - [
      bash,
      -c,
      "curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh",
    ]

  # Install LD.Apport toolchain versions using mise. Use direct paths later, not mise shims.
  - [
      bash,
      -c,
      "MISE_DATA_DIR=/opt/mise /usr/local/bin/mise install node@${node_version} dotnet@${dotnet_version}",
    ]

  # Install Corepack's shims as root. Populate the agent cache as azdoagent below.
  - [
      bash,
      -c,
      '. /etc/profile.d/azdo-tools.sh && COREPACK_HOME=/root/.cache/corepack corepack enable',
    ]

  # Preinstall Chromium system dependencies for Playwright E2E jobs.
  - [
      bash,
      -c,
      '. /etc/profile.d/azdo-tools.sh && npx -y playwright@${playwright_version} install-deps chromium',
    ]

  - [bash, -c, "/opt/azdo/configure_agent_environment.sh"]
  - [bash, -c, "systemctl enable --now docker || true"]
  - [bash, -c, "systemctl enable --now fail2ban || true"]
  - [bash, -c, "usermod -aG docker azureuser || true"]
  - [bash, -c, "usermod -aG docker azdoagent || true"]
  - [bash, -c, ". /etc/azdo/ld-apport-cache-env.sh && install -d -m 0755 -o azdoagent -g azdoagent /home/azdoagent/.dotnet /home/azdoagent/.dotnet/tools $LD_APPORT_CACHE_DIRS"]
  - [bash, -c, "runuser -u azdoagent -- bash -lc '. /etc/profile.d/azdo-tools.sh && corepack prepare pnpm@${pnpm_version} --activate'"]
  - [bash, -c, "runuser -u azdoagent -- bash -lc '. /etc/profile.d/azdo-tools.sh && npx -y playwright@${playwright_version} install chromium'"]
  - [bash, -c, "for attempt in 1 2 3; do docker pull ${sql_server_image} && exit 0; sleep 10; done; echo 'WARNING: failed to pre-pull SQL Server image ${sql_server_image}' >&2; exit 0"]
  - [bash, -c, "/opt/azdo/install_agents.sh"]
