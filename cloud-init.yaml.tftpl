#cloud-config
package_update: true
package_upgrade: true
ssh_pwauth: false

users:
  - name: azureuser
    groups: sudo,docker
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  - curl
  - git
  - jq
  - ca-certificates
  - gnupg
  - apt-transport-https
  - zip
  - unzip
  - docker.io
  - ufw
  - fail2ban

write_files:
  - path: /etc/azdo/pat
    permissions: "0600"
    owner: root:root
    content: |
      ${azure_pat}

  - path: /opt/azdo/install_agents.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail

      ORG_URL="${azure_org_url}"
      POOL="${azure_agent_pool}"
      PAT_FILE="/etc/azdo/pat"
      AGENT_PREFIX="${agent_name_prefix}"
      BASE_DIR="/opt/azdo"

      mkdir -p "$${BASE_DIR}"
      chmod 750 "$${BASE_DIR}"

      for i in $(seq 1 ${agents_per_vm}); do
        AGENT_DIR="$${BASE_DIR}/agent$${i}"
        AGENT_NAME="$${AGENT_PREFIX}-$(hostname)"
        if [ ${agents_per_vm} -gt 1 ]; then
          AGENT_NAME="$${AGENT_NAME}-$${i}"
        fi

        rm -rf "$${AGENT_DIR}"
        mkdir -p "$${AGENT_DIR}"
        cd "$${AGENT_DIR}"

        curl -fsSL -o agent.tar.gz "https://vstsagentpackage.azureedge.net/agent/${azdo_agent_version}/vsts-agent-linux-x64-${azdo_agent_version}.tar.gz"
        tar -zxf agent.tar.gz
        rm agent.tar.gz

        export AGENT_ALLOW_RUNASROOT=1
        ./config.sh \
          --unattended \
          --url "${azure_org_url}" \
          --auth pat \
          --token "$(cat $${PAT_FILE})" \
          --pool "${azure_agent_pool}" \
          --agent "$${AGENT_NAME}" \
          --acceptTeeEula \
          --replace

        ./svc.sh install
        ./svc.sh start
      done

runcmd:
  - [bash, -c, "ufw allow OpenSSH || true"]
  - [bash, -c, "ufw --force enable || true"]
  - [bash, -c, "mkdir -p /etc/apt/keyrings"]

  # Node.js 24 LTS (via NodeSource APT)
  - [
      bash,
      -c,
      "curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg",
    ]
  - [
      bash,
      -c,
      "echo 'deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main' > /etc/apt/sources.list.d/nodesource.list",
    ]

  # .NET SDK 10 (via Microsoft APT)
  - [
      bash,
      -c,
      "curl -fsSL https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb -o /tmp/packages-microsoft-prod.deb",
    ]
  - [bash, -c, "dpkg -i /tmp/packages-microsoft-prod.deb"]
  - [bash, -c, "rm -f /tmp/packages-microsoft-prod.deb"]

  - [bash, -c, "apt-get update"]
  - [bash, -c, "apt-get install -y nodejs dotnet-sdk-10.0"]

  - [bash, -c, "systemctl enable --now docker || true"]
  - [bash, -c, "systemctl enable --now fail2ban || true"]
  - [bash, -c, "usermod -aG docker azureuser || true"]
  - [bash, -c, "/opt/azdo/install_agents.sh"]
