#cloud-config
package_update: true
package_upgrade: true
ssh_pwauth: false

users:
  - name: azureuser
    groups: sudo,docker
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  - curl
  - git
  - jq
  - ca-certificates
  - gnupg
  - apt-transport-https
  - zip
  - unzip
  - docker.io
  - ufw
  - fail2ban

write_files:
  - path: /etc/azdo/pat
    permissions: "0600"
    owner: root:root
    content: |
      ${azure_pat}

  - path: /opt/azdo/install_agents.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail

      ORG_URL="${azure_org_url}"
      POOL="${azure_agent_pool}"
      PAT_FILE="/etc/azdo/pat"
      BASE_DIR="/opt/azdo"

      # Ensure mise tools are available
      export MISE_DATA_DIR=/opt/mise
      export MISE_CONFIG_DIR=/etc/mise
      export PATH="/opt/mise/shims:$PATH"

      mkdir -p "$${BASE_DIR}"
      chmod 750 "$${BASE_DIR}"

      for i in $(seq 1 ${agents_per_vm}); do
        AGENT_DIR="$${BASE_DIR}/agent$${i}"
        AGENT_NAME="$(hostname)"
        if [ ${agents_per_vm} -gt 1 ]; then
          AGENT_NAME="$${AGENT_NAME}-$${i}"
        fi

        rm -rf "$${AGENT_DIR}"
        mkdir -p "$${AGENT_DIR}"
        cd "$${AGENT_DIR}"

        DOWNLOAD_URL="https://download.agent.dev.azure.com/agent/${azdo_agent_version}/vsts-agent-linux-x64-${azdo_agent_version}.tar.gz"
        echo "Downloading agent from: $${DOWNLOAD_URL}"
        
        MAX_RETRIES=10
        RETRY_COUNT=0
        until curl -fsSL -o agent.tar.gz "$${DOWNLOAD_URL}"; do
          RETRY_COUNT=$((RETRY_COUNT + 1))
          if [ $${RETRY_COUNT} -ge $${MAX_RETRIES} ]; then
            echo "Failed to download agent after $${MAX_RETRIES} attempts. Exiting."
            exit 1
          fi
          echo "Download failed (attempt $${RETRY_COUNT}/$${MAX_RETRIES}), retrying in 5 seconds..."
          sleep 5
        done
        tar -zxf agent.tar.gz
        rm agent.tar.gz

        export AGENT_ALLOW_RUNASROOT=1
        ./config.sh \
          --unattended \
          --url "${azure_org_url}" \
          --auth pat \
          --token "$(cat $${PAT_FILE})" \
          --pool "${azure_agent_pool}" \
          --agent "$${AGENT_NAME}" \
          --acceptTeeEula \
          --replace

        ./svc.sh install
        ./svc.sh start
      done

runcmd:
  - [bash, -c, "until ping -c 1 google.com; do sleep 2; done"]
  - [bash, -c, "ufw allow OpenSSH || true"]
  - [bash, -c, "ufw --force enable || true"]

  # Install mise (system-wide)
  - [
      bash,
      -c,
      "curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh",
    ]

  # Install Node.js and .NET using mise
  - [bash, -c, "mkdir -p /etc/mise"]
  - [
      bash,
      -c,
      "MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/etc/mise /usr/local/bin/mise use --global node@24 dotnet@10",
    ]

  # Ensure mise-installed tools are in the PATH for the agent installation and future shells
  - [bash, -c, "echo 'export MISE_DATA_DIR=/opt/mise' >> /etc/environment"]
  - [bash, -c, "echo 'export MISE_CONFIG_DIR=/etc/mise' >> /etc/environment"]
  - [bash, -c, 'echo ''PATH="/opt/mise/shims:$PATH"'' >> /etc/environment']

  - [bash, -c, "systemctl enable --now docker || true"]
  - [bash, -c, "systemctl enable --now fail2ban || true"]
  - [bash, -c, "usermod -aG docker azureuser || true"]
  - [
      bash,
      -c,
      'MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/etc/mise PATH="/opt/mise/shims:$PATH" /opt/azdo/install_agents.sh',
    ]
