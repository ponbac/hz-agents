# Copy this file to secret.auto.tfvars and fill in real values.
# secret.auto.tfvars is ignored by git.

# Hetzner Cloud API token with permission to create/read/delete servers,
# firewalls, and read SSH keys in the target project.
hcloud_token = "REPLACE_WITH_HETZNER_CLOUD_TOKEN"

# Single Azure DevOps PAT used both by Terraform and by cloud-init agent registration.
# Required access: Agent Pools read/manage, pipeline resource/queue authorization,
# and read access to the target project.
azure_pat = "REPLACE_WITH_AZURE_DEVOPS_PAT"

# Azure DevOps organization URL.
azure_org_url = "https://dev.azure.com/lerumsdjur"

# Azure DevOps project that should receive the agent queue authorization.
azure_project_name = "Lerums Djursjukhus"

# Existing SSH key name in Hetzner Cloud. This key is attached to the VM
# and authorized for the azureuser account.
ssh_key_name = "REPLACE_WITH_EXISTING_HETZNER_SSH_KEY_NAME"

# Initial production-safe capacity. Increase only after pipelines are proven
# self-hosted-safe and Azure DevOps parallel-job capacity is available.
vm_count       = 1
agents_per_vm = 1

# Optional overrides. Uncomment if needed.
# azure_agent_pool = "LD.Apport-Hetzner"
# agent_name_prefix = "hz-agent"
# image = "ubuntu-26.04"
# location = "nbg1"
# server_type = "cx43"
# azdo_agent_version = "4.266.2"
# dotnet_version = "10.0.300"
# node_version = "24.13.0"
# pnpm_version = "11.10.0"
# playwright_version = "1.61.0"
# sql_server_image = "mcr.microsoft.com/mssql/server:2025-CU2-ubuntu-22.04"
